# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Claude (Anthropic API, paid per token, no daily limit): the English storyboard
# (Claude Haiku) and the spoken lines in the film's language (Claude Sonnet)
ANTHROPIC_API_KEY=

# Azure AI Speech (free tier F0, counted per month): voices and the listen-back check.
# Region is the Speech resource's region, e.g. eastus or westeurope.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Gemini API (Google AI Studio, free tier, about 10 requests a day per model):
# fallback for writing and voices, and the mask finder for masked scenes
GEMINI_API_KEY=

# Optional free hosts for the English storyboard. Name a model "groq/<id>",
# "cerebras/<id>" or "openrouter/<id>" in storyboard.json models.script to use one.
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# Cloudflare Workers AI (free daily allowance): keyframes
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Kaggle (phone-verified account, free weekly GPU quota): moving shots + music
# Either the classic pair from kaggle.json ...
KAGGLE_USERNAME=
KAGGLE_KEY=
# ... or the newer single API token
KAGGLE_API_TOKEN=

# Optional: path to a full FFmpeg build. Default: ffmpeg on PATH, else the
# imageio-ffmpeg binary that `uv sync` installs.
FFMPEG_BIN=

# WaveSpeed AI (pay-per-use, $1 trial credit): moving shots (Wan 2.2 I2V) + score (ACE-Step 1.5)
WAVESPEED_API_KEY=
