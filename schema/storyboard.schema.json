{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Korvowastaken/10x-video-gen/schema/storyboard.schema.json",
  "title": "Heritage Short storyboard",
  "description": "The contract between every pipeline stage. Each stage reads this file and writes only its own outputs. Prompts, seeds, voices and music settings live here, not in code, so a run is reproducible and explainable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "logline", "audience", "language", "models", "style", "characters", "locations", "shots", "music", "end_card"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "logline": { "type": "string", "minLength": 10, "maxLength": 400 },
    "source": {
      "description": "Where this storyboard came from. Written by the script stage.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "story_file": { "type": "string" },
        "story_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "model": { "type": "string" },
        "generated_at": { "type": "string" },
        "attempts": { "type": "integer", "minimum": 1 }
      }
    },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["who", "where", "feel"],
      "properties": {
        "who": { "type": "string", "minLength": 5 },
        "where": { "type": "string", "minLength": 3 },
        "feel": { "type": "string", "minLength": 5, "description": "What they should feel or understand at the end." }
      }
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name", "subtitles"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z]{2,3}$" },
        "name": { "type": "string" },
        "script": { "type": "string", "description": "Writing system of the spoken lines, e.g. Ge'ez (Ethiopic)." },
        "subtitles": { "const": "en" }
      }
    },
    "models": {
      "description": "Model IDs this run uses. Fallback lists are tried in order.",
      "type": "object",
      "additionalProperties": false,
      "required": ["tts", "image", "video", "music"],
      "properties": {
        "script": { "$ref": "#/$defs/modelList" },
        "tts": { "$ref": "#/$defs/modelList" },
        "listen": { "$ref": "#/$defs/modelList" },
        "image": { "$ref": "#/$defs/modelList" },
        "video": { "type": "string" },
        "music": { "type": "string" }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block", "negative"],
      "properties": {
        "block": { "type": "string", "minLength": 20, "description": "Look description added to every image prompt (palette, light, medium)." },
        "motion": { "type": "string", "description": "Short style tag added to every video prompt." },
        "negative": { "type": "string", "description": "What to avoid; used where the model supports a negative prompt." },
        "palette": { "type": "array", "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" } }
      }
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/character" }
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "look"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string" },
          "look": { "type": "string", "minLength": 10 },
          "reference": { "$ref": "#/$defs/reference" }
        }
      }
    },
    "shots": {
      "description": "Eight to twelve shots, in screen order.",
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/shot" }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caption", "bpm", "key", "duration_s", "instrumental", "seeds"],
      "properties": {
        "caption": { "type": "string", "minLength": 10, "description": "Style, mood, instruments, texture. No tempo or key here: those have their own fields." },
        "bpm": { "type": "integer", "minimum": 40, "maximum": 200 },
        "key": { "type": "string", "pattern": "^[A-G](#|b)? (major|minor)$", "description": "e.g. 'D minor', 'G major' (ACE-Step's keyscale)." },
        "time_signature": { "enum": ["2/4", "3/4", "4/4", "6/8"] },
        "duration_s": { "type": "number", "minimum": 20, "maximum": 240 },
        "instrumental": { "type": "boolean" },
        "lyrics": { "type": "string" },
        "seeds": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "integer", "minimum": 0 } },
        "chosen": { "type": ["integer", "null"], "minimum": 0, "description": "Index into seeds of the candidate the film uses." },
        "chosen_reason": { "type": "string" },
        "gain_db": { "type": "number", "minimum": -30, "maximum": 6 },
        "cues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["at", "note"],
            "properties": { "at": { "$ref": "#/$defs/shotId" }, "note": { "type": "string" } }
          }
        },
        "ducking": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "threshold": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "ratio": { "type": "number", "minimum": 1, "maximum": 20 },
            "attack_ms": { "type": "number", "minimum": 1, "maximum": 2000 },
            "release_ms": { "type": "number", "minimum": 10, "maximum": 9000 }
          }
        }
      }
    },
    "end_card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "lines", "duration_s"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "lines": { "type": "array", "items": { "type": "string" } },
        "duration_s": { "type": "number", "minimum": 2, "maximum": 6 }
      }
    },
    "video": {
      "description": "Wan settings for the moving shots. Defaults are drafting settings for a Kaggle T4.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 256, "maximum": 1280, "multipleOf": 32 },
        "height": { "type": "integer", "minimum": 256, "maximum": 1280, "multipleOf": 32 },
        "frames": { "type": "integer", "enum": [49, 65, 81, 97, 121] },
        "steps": { "type": "integer", "minimum": 4, "maximum": 60 },
        "guidance": { "type": "number", "minimum": 1, "maximum": 10 },
        "flow_shift": { "type": "number", "minimum": 1, "maximum": 12 },
        "dtype": { "enum": ["fp16", "bf16"] },
        "budget_min": { "type": "number", "minimum": 5, "maximum": 300, "description": "Stop starting new shots after this many minutes of a Kaggle session." }
      }
    },
    "edit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fps": { "type": "integer", "enum": [24, 25, 30] },
        "lead_s": { "type": "number", "minimum": 0, "maximum": 3, "description": "Silence before the first line of a shot." },
        "gap_s": { "type": "number", "minimum": 0, "maximum": 3, "description": "Pause between lines inside a shot." },
        "tail_s": { "type": "number", "minimum": 0, "maximum": 4, "description": "Hold after the last line of a shot." },
        "caption_chars": { "type": "integer", "minimum": 20, "maximum": 60 }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,31}$" },
    "shotId": { "type": "string", "pattern": "^S[0-9]{2}$" },
    "modelList": {
      "oneOf": [
        { "type": "string", "minLength": 3 },
        { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } }
      ]
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "seeds"],
      "properties": {
        "prompt": { "type": "string", "minLength": 10 },
        "seeds": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "integer", "minimum": 0 } },
        "chosen": { "type": "integer", "minimum": 0, "description": "Index into seeds of the approved (golden) reference." }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "role", "visible", "real_person", "voice"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "role": { "enum": ["narrator", "character"] },
        "visible": { "type": "boolean", "description": "False for a voice-only narrator." },
        "real_person": { "type": "boolean", "description": "True if this character portrays or voices a real person." },
        "consent": { "type": "string", "pattern": "^C[0-9]+$", "description": "ID of this person's consent record in ETHICS.md. Required when real_person is true." },
        "look": { "type": "string", "minLength": 10, "description": "Visual description repeated in every prompt that shows this character." },
        "reference": { "$ref": "#/$defs/reference" },
        "voice": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "direction"],
          "properties": {
            "name": { "type": "string", "minLength": 2, "description": "Prebuilt Gemini TTS voice, e.g. Kore, Charon, Sulafat." },
            "direction": { "type": "string", "minLength": 3, "description": "Plain-language delivery note: age, pace, warmth." }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "visible": { "const": true } } }, "then": { "required": ["look", "reference"] } },
        { "if": { "properties": { "real_person": { "const": true } } }, "then": { "required": ["consent"] } }
      ]
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "beat", "reason", "size", "location", "characters", "duration_s", "keyframe", "motion", "lines"],
      "properties": {
        "id": { "$ref": "#/$defs/shotId" },
        "beat": { "type": "string", "minLength": 5, "description": "What changes in the story in this shot." },
        "reason": { "type": "string", "minLength": 10, "description": "Why the film needs this shot." },
        "size": { "enum": ["extreme-wide", "wide", "medium", "medium-close-up", "close-up", "extreme-close-up", "insert", "over-the-shoulder"] },
        "location": { "$ref": "#/$defs/id" },
        "characters": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true },
        "duration_s": { "type": "number", "minimum": 2, "maximum": 12, "description": "Planned length; the narration timing can stretch it." },
        "keyframe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prompt", "seed"],
          "properties": {
            "prompt": { "type": "string", "minLength": 10, "description": "What the still shows. The style block and character looks are added in code." },
            "seed": { "type": "integer", "minimum": 0 }
          }
        },
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "prompt"],
          "properties": {
            "mode": { "enum": ["video", "kenburns", "still"] },
            "prompt": { "type": "string", "description": "Only the motion and the camera: the keyframe already holds the subject." },
            "seed": { "type": "integer", "minimum": 0 },
            "kenburns": { "enum": ["zoom-in", "zoom-out", "pan-left", "pan-right", "pan-up", "pan-down"] }
          }
        },
        "lines": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["speaker", "text", "en"],
            "properties": {
              "speaker": { "$ref": "#/$defs/id" },
              "text": { "type": "string", "minLength": 1, "description": "The spoken line, in the film's language." },
              "en": { "type": "string", "minLength": 1, "description": "English subtitle for the line." },
              "direction": { "type": "string", "description": "Overrides the speaker's delivery note for this line." }
            }
          }
        },
        "music_cue": { "type": "string" }
      }
    }
  }
}
